# --- Sirlar: ASLA repoya girmez ---
.env
.env.*
# Istisna: ornek dosya sir ICERMEZ ve paylasilmasi gerekir - sartname
# Md. 9 "calistirilmasi icin gerekli tum adimlar" kapsaminda.
!.env.ornek
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Loglar ---
logs/
*.log

# --- Node / React (dashboard) ---
node_modules/
dist/
.vite/
npm-debug.log*

# --- Isletim sistemi / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# --- Buyuk model dosyalari (Ollama/HuggingFace kendi onbelleginde tutar) ---
*.gguf
*.safetensors
models/

# --- Gecici veri ---
*.tmp
.cache/

# --- Imzalanmamis kayitlarin ekran goruntuleri ---
# Etiketleme kuyrugundan acilan 200 taslak icin alinan goruntuler 132 MB
# tutuyordu; depo 65 MB'dan 200 MB'a cikacakti. Taslaklar zaten olcum
# disi oldugu icin kanitlarinin depoda durmasi sart degil - goruntuler
# yerelde, gold_dataset/ekran_goruntuleri/ altinda duruyor.
#
# ONEMLI: bu kural yalnizca TAKIP EDILMEYEN dosyalari etkiler. Daha once
# commit edilmis 103 imzali kaydin goruntusu takipte kalir ve silinmez.
#
# Bir kayit imzalandiginda goruntusunu depoya almak icin -f gerekir:
#     git add -f gold_dataset/ekran_goruntuleri/KT-018.png
gold_dataset/ekran_goruntuleri/*.png
