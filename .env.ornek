# KatilimAI - ornek ortam degiskenleri
#
# Bu dosyayi ".env" olarak kopyalayip duzenleyin. .env repoya KONMAZ
# (.gitignore'da) - parolalar ve makineye ozel ayarlar kisiseldir.
#
# HICBIRI ZORUNLU DEGIL: sistem donanimi tespit edip makul varsayilanlari
# kendi secer (bkz. donanim.py). Bu dosya yalnizca otomatik secimi
# ezmek istediginizde gerekir.
#
# Makinenizin ne secdigini gormek icin:  python donanim_testi.py --hizli


# --- Donanim profili ---------------------------------------------------
# Otomatik secim VRAM'e bakar: >= 8 GB ise "gpu", degilse "cpu".
# Elle zorlamak icin (gpu | cpu):
# KATILIMAI_PROFIL=gpu

# Tek tek ayarlar (profilden bagimsiz ezer):
# LLM_BAGLAM_PENCERESI=16384     # Ollama num_ctx. Buyutmek zayif makinede
#                                # zaman asimina yol acar (olculdu).
# LLM_ZAMAN_ASIMI=300            # saniye. CPU'da 900, GPU'da 300 yeterli.
# EMBEDDING_YIGIN_BOYUTU=128     # buyuk yigin GPU'da hizlandirir.


# --- Arac zaman asimi --------------------------------------------------
# agent/orchestrator.py::_arac_cagir_zaman_asimi bu esigi kullanir.
# Arac (ozellikle RAG - embedding hesaplamasi) bu sure dolmadan sonuc
# dondurezse kullaniciya acik bir hata mesaji gonderilir; sessiz
# kilitlenme olmaz. Varsayilan: 900 sn (CPU profili p95 esigi).
# KATILIMAI_ARAC_ZAMAN_ASIMI=900


# --- RAG exact arama modu ---------------------------------------------
# true: Qdrant HNSW yaklasik arama yerine tam brute-force tarama yapar.
# Recall@1 oynama sorununu (README: 29/30/29 kosu degisimi) giderir.
# YALNIZCA olcum/test sirasinda kullanin - uretimde gereksiz yavaslatir.
# Varsayilan: false (hizli yaklasik arama)
# KATILIMAI_RAG_EXACT_MOD=true


# --- Veri kaynagi ------------------------------------------------------
# false: mock/sozlesme testi verisi (varsayilan)
# true : PostgreSQL'deki gercek veri
# GERCEK_VERI_AKTIF=true


# --- Kimlik dogrulama --------------------------------------------------
# false (varsayilan): herhangi bir "Bearer <token>" kabul edilir
# true: gercek JWT dogrulanir - JWT_SECRET ZORUNLU olur
# JWT_AKTIF=true
# JWT_SECRET=buraya-uzun-ve-rastgele-bir-deger-yazin


# --- Servis adresleri --------------------------------------------------
# DATABASE_URL=postgresql+psycopg://katilim:katilim_dev@localhost:5432/katilimai
# QDRANT_URL=http://localhost:6333
# QDRANT_KOLEKSIYON=kampanya_parcalari


# --- Modeller ----------------------------------------------------------
# EMBEDDING_MODELI=intfloat/multilingual-e5-base
# EMBEDDING_BOYUTU=768

# HuggingFace kimlik dogrulama tokeni.
# Tanimlanmazsa HF Hub'a anonim istek gider; rate-limit'e takilabilir ve
# CI test suresi uzar (olculdu: ~120 sn). Token olusturmak icin:
#   https://huggingface.co/settings/tokens  (Read izni yeterli)
# CI'da GitHub Actions Secret olarak ekleyin: HF_TOKEN=hf_xxx...
# HF_TOKEN=hf_buraya_tokeninizi_yazin

# Dusuk bellekli sistemlerde GLiNER modelini devre disi birakmak icin:
# KATILIMAI_GLINER_DISABLE=1


# --- PostgreSQL (docker compose) ---------------------------------------
# Varsayilanlar yalnizca YEREL gelistirme icindir.
# POSTGRES_USER=katilim
# POSTGRES_PASSWORD=degistirin
# POSTGRES_DB=katilimai


# --- EVREN cikarim altyapisi (TEKNOFEST 2026 resmi) ---------------------
# bkz. docs/adr/0002-evren-cikarim-entegrasyonu.md - karar ve gerekcesi.
#
# TANIMLI DEGILSE hicbir sey degismez: sistem yerel Ollama (cikarim) ve
# yerel sentence-transformers (embedding) kullanmaya devam eder - demonun
# "internet gerekmiyor" ozelligi korunur.
#
# TANIMLIYSA extraction/llm_extractor.py OTOMATIK EVREN'in llm-fast
# alias'ina, chunking/embedding.py OTOMATIK bge-m3-embed alias'ina gecer
# (donanim.py'nin GPU/CPU otomatik secimiyle AYNI mantik).
#
# EVREN_API_KEY=sk-evren-teamNN-XXXXXXXX
# EVREN_TEAM=teamNN
#
# EMBEDDING BOYUTU: bge-m3-embed 1024 boyutlu vektor uretir, yerel e5-base
# 768 uretir. chunking/qdrant_baglanti.py::VARSAYILAN_KOLEKSIYON bunu
# OTOMATIK yonetir - QDRANT_KOLEKSIYON asagida ELLE VERILMEDIYSE, EVREN
# aktifken koleksiyon adina otomatik "_evren" soneki eklenir (ör.
# kampanya_parcalari -> kampanya_parcalari_evren). Boylece iki saglayici
# ayni koleksiyona karisamaz. Saglayici DEGISTIRILDIGINDE (EVREN_API_KEY
# eklenip/cikarildiginda) o koleksiyonun `sifirla=True` ile yeniden
# olusturulup TUM korpusun yeniden indekslenmesi hala gerekir - otomatik
# isimlendirme yalnizca KARISMAYI onler, indekslemeyi degil.
# QDRANT_KOLEKSIYON elle verilirse (asagida) bu otomatik ayrim DEVRE DISI
# kalir - o zaman saglayici degisiminde koleksiyon adini SIZ ayirmalisiniz.
#
# Zaman asimi (saniye) - EVREN yiginin HER katmani 1800 sn kullanir,
# degistirmeyin:
# EVREN_ZAMAN_ASIMI=1800
#
# Alias adlari (varsayilanlar dokumantasyondaki isimlerle AYNI, degistirmeye
# gerek yok - bkz. ADR neden llm-fast/bge-m3-embed secildi):
# EVREN_LLM_MODELI=llm-fast
# EVREN_EMBED_MODELI=bge-m3-embed
#
# EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
#
# --- RAG_MODE (getirme yontemi) -----------------------------------------
# "hibrit" (yogun+seyrek, RRF) | "dense" (yalniz yogun). Bos birakilirsa
# saglayiciya gore otomatik secilir: EVREN pasifken "hibrit" (yerel
# e5-base ile zaten olculup varsayilan yapilmisti, degismedi), EVREN
# aktifken "dense" (EVREN'in kendi olcumunde hibrit/rerank saf yogun
# getirmenin altinda kaliyor - bkz. ADR 0002). Iki modu ayni gold set
# uzerinde karsilastirmak icin ACIKCA zorlanabilir:
# RAG_MODE=dense
#
# chunking/retriever.py::ASGARI_VEKTOR_SKORU (menu-kirliligi esigi, 0.40)
# YALNIZCA yerel e5-base icin olculdu - bge-m3-embed ile gercek anahtarla
# yeniden olculmeden bu deger EVREN yolunda da aynen kullanilir (bilincli
# gecici karar). Yeniden kalibre edilene kadar gerekirse ezilebilir:
# ASGARI_VEKTOR_SKORU=0.40


# --- RAG kalite bayraklari (chunking/retriever.py::getir) ---------------
# KATILIMAI_BANKA_OTOMATIK: varsayilan true (25 Agustos 2026'da olculup
# dogrulandi - bkz. docs/rag_tasarim_ve_olcum.md, Bulgu 9 guncellemesi).
# Sorgudaki banka adini metadata filtresine tasir; banka_ve_konu
# kategorisinde Recall@3 %28,57->%38,10 kazanc olculdu. Kapatmak icin:
# KATILIMAI_BANKA_OTOMATIK=false
#
# KATILIMAI_RERANK: varsayilan true. Cross-encoder yeniden siralamayi
# acar/kapatir - yalnizca GOSTERILEN parcalarin sirasini etkiler,
# cevaplanabilirlik kararini degil (bkz. Bulgu 9). Kapatmak icin:
# KATILIMAI_RERANK=false
#
# EVREN ayrica takim basina izole bir Qdrant ornegi sagliyor - bilinerek
# KULLANILMIYOR (bkz. ADR): projenin kendi Qdrant altyapisi (hibrit
# koleksiyon, migration'lar, yerel dosya modu) zaten olgun ve tam kontrol
# sagliyor, EVREN tarafinda olculmus bir avantaj yok. Denemek isteyen icin
# adresler yine de not edilir:
# EVREN_QDRANT_URL=https://evren-vektor.ssyz.org.tr
# EVREN_QDRANT_KEY=qdr-teamNN-XXXXXXXX
