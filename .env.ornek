# KatilimAI - ornek ortam degiskenleri
#
# Bu dosyayi ".env" olarak kopyalayip duzenleyin. .env repoya KONMAZ
# (.gitignore'da) - parolalar ve makineye ozel ayarlar kisiseldir.
#
# HICBIRI ZORUNLU DEGIL: sistem donanimi tespit edip makul varsayilanlari
# kendi secer (bkz. donanim.py). Bu dosya yalnizca otomatik secimi
# ezmek istediginizde gerekir.
#
# Makinenizin ne secdigini gormek icin:  python donanim_testi.py --hizli


# --- Donanim profili ---------------------------------------------------
# Otomatik secim VRAM'e bakar: >= 8 GB ise "gpu", degilse "cpu".
# Elle zorlamak icin (gpu | cpu):
# KATILIMAI_PROFIL=gpu

# Tek tek ayarlar (profilden bagimsiz ezer):
# LLM_BAGLAM_PENCERESI=16384     # Ollama num_ctx. Buyutmek zayif makinede
#                                # zaman asimina yol acar (olculdu).
# LLM_ZAMAN_ASIMI=300            # saniye. CPU'da 900, GPU'da 300 yeterli.
# EMBEDDING_YIGIN_BOYUTU=128     # buyuk yigin GPU'da hizlandirir.


# --- Veri kaynagi ------------------------------------------------------
# false: mock/sozlesme testi verisi (varsayilan)
# true : PostgreSQL'deki gercek veri
# GERCEK_VERI_AKTIF=true


# --- Kimlik dogrulama --------------------------------------------------
# false (varsayilan): herhangi bir "Bearer <token>" kabul edilir
# true: gercek JWT dogrulanir - JWT_SECRET ZORUNLU olur
# JWT_AKTIF=true
# JWT_SECRET=buraya-uzun-ve-rastgele-bir-deger-yazin


# --- Servis adresleri --------------------------------------------------
# DATABASE_URL=postgresql+psycopg://katilim:katilim_dev@localhost:5432/katilimai
# QDRANT_URL=http://localhost:6333
# QDRANT_KOLEKSIYON=kampanya_parcalari


# --- Modeller ----------------------------------------------------------
# EMBEDDING_MODELI=intfloat/multilingual-e5-base
# EMBEDDING_BOYUTU=768


# --- PostgreSQL (docker compose) ---------------------------------------
# Varsayilanlar yalnizca YEREL gelistirme icindir.
# POSTGRES_USER=katilim
# POSTGRES_PASSWORD=degistirin
# POSTGRES_DB=katilimai
